<?xml version="1.0"?>
<sdf version="1.11">
  <model name="viper">
  <!-- <pose> 2 0 0 0 0 -1.57</pose> -->
  <!-- <static>true</static> -->
    <link name="base_link">
      <pose>0 0 0.7725 0 0 0</pose> <!--0.7725-->
      <inertial>
        <mass>0.8</mass>
        <pose>0 0 0 0 0 0</pose>
        <inertia>
          <ixx>0.042</ixx>
          <iyy>0.042</iyy>
          <izz>0.0001</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <visual name="body_visual">
        <geometry>
          <cylinder>
            <radius>0.052</radius>
            <length>1.0</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.2 1</ambient>
          <diffuse>0.4 0.4 0.4 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>

      <collision name="body_collision">
        <geometry>
          <cylinder>
            <radius>0.052</radius>
            <length>1.0</length>
          </cylinder>
        </geometry>
      </collision>

      <sensor name="imu_sensor" type="imu">
        <always_on>1</always_on>
        <update_rate>250</update_rate>
        <pose>0 0 0 0 0 0</pose>
        <visualize>1</visualize>
        <imu>
          <angular_velocity>
            <x>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.0001</stddev>
                <dynamic_bias_stddev>1e-05</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>1000</dynamic_bias_correlation_time>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.0001</stddev>
                <dynamic_bias_stddev>1e-05</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>1000</dynamic_bias_correlation_time>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.00001</stddev>
                <dynamic_bias_stddev>1e-05</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>1000</dynamic_bias_correlation_time>
              </noise>
            </z>
          </angular_velocity>
          <linear_acceleration>
            <x>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.001</stddev>
                <dynamic_bias_stddev>0.001</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>300</dynamic_bias_correlation_time>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.001</stddev>
                <dynamic_bias_stddev>0.001</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>300</dynamic_bias_correlation_time>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.0001</stddev>
                <dynamic_bias_stddev>0.0001</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>300</dynamic_bias_correlation_time>
              </noise>
            </z>
          </linear_acceleration>
        </imu>
      </sensor>

      <sensor name="air_pressure_sensor" type="air_pressure">
        <always_on>1</always_on>
        <update_rate>50</update_rate>
        <air_pressure>
          <pressure>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>0.01</stddev>
            </noise>
          </pressure>
        </air_pressure>
      </sensor>

      <sensor name="navsat_sensor" type="navsat">
        <always_on>1</always_on>
        <update_rate>30</update_rate>
      </sensor>

    </link>

    <link name="top_cone">
      <pose>0 0 1.3225 0 0 0</pose>
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>1e-5</ixx>
          <iyy>1e-5</iyy>
          <izz>1e-5</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <visual name="top_cone_visual">
        <geometry>
          <cone>
            <radius>0.052</radius>
            <length>0.1</length>
          </cone>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.2 1</ambient>
          <diffuse>0.4 0.4 0.4 1</diffuse>
        </material>
      </visual>

      <collision name="top_cone_collision">
        <geometry>
          <cone>
            <radius>0.052</radius>
            <length>0.1</length>
          </cone>
        </geometry>
      </collision>
    </link>

    <link name="gimbal_mount">
      <pose>0 0 0.2525 0 0 0</pose>
      <inertial>
        <mass>0.005</mass>
        <inertia>
          <ixx>1e-5</ixx>
          <iyy>1e-5</iyy>
          <izz>1e-5</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <visual name="gimbal_mount_visual">
        <geometry>
          <!-- <box>
            <size>0.08 0.08 0.04</size>
          </box> -->
          <cylinder>
            <radius>0.10</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.3 0.3 0.3 1</diffuse>
        </material>
      </visual>

      <collision name="gimbal_mount_collision">
        <geometry>
          <!-- <box>
            <size>0.08 0.08 0.04</size>
          </box> -->
          <cylinder>
            <radius>0.10</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
      </collision>
    </link>


    <joint name="base_to_gimbal_mount" type="fixed">
      <parent>base_link</parent>
      <child>gimbal_mount</child>
    </joint>

    <joint name="top_cone_to_base" type="fixed">
      <parent>base_link</parent>
      <child>top_cone</child>
    </joint>

    <!-- <joint name="top_cone_to_base" type="fixed">
      <parent>gimbal_mount</parent>
      <child>extender</child>
    </joint> -->

    <joint name="leg_1_joint" type="fixed">
      <parent>base_link</parent>
      <child>landing_leg_1</child>
    </joint>
    <joint name="leg_2_joint" type="fixed">
      <parent>base_link</parent>
      <child>landing_leg_2</child>
    </joint>
    <joint name="leg_3_joint" type="fixed">
      <parent>base_link</parent>
      <child>landing_leg_3</child>
    </joint>
    <joint name="leg_4_joint" type="fixed">
      <parent>base_link</parent>
      <child>landing_leg_4</child>
    </joint>

    <!-- Joints connecting legs to their bases -->
    <joint name="leg_1_to_base_1" type="fixed">
      <parent>landing_leg_1</parent>
      <child>landing_base_1</child>
    </joint>
    <joint name="leg_2_to_base_2" type="fixed">
      <parent>landing_leg_2</parent>
      <child>landing_base_2</child>
    </joint>
    <joint name="leg_3_to_base_3" type="fixed">
      <parent>landing_leg_3</parent>
      <child>landing_base_3</child>
    </joint>
    <joint name="leg_4_to_base_4" type="fixed">
      <parent>landing_leg_4</parent>
      <child>landing_base_4</child>
    </joint>

    <joint name="servo0_roll_joint" type="revolute">
      <parent>gimbal_mount</parent>
      <child>servo0_roll</child>
      <!-- <pose>0 0 0.1675 0 0 0</pose> -->
      <axis>
        <xyz>
        1 0 0
        </xyz>
        <limit>
          <lower>-1</lower>
          <upper>1</upper>
          <!-- <effort>1.0</effort>
          <velocity>10.0</velocity> -->
        </limit>
        <!-- <dynamics>
          <damping>1.0</damping>  
          <friction>0.02</friction> 
        </dynamics> -->
      </axis>
    </joint>

    <joint name="servo1_pitch_joint" type="revolute">
      <parent>servo0_roll</parent>
      <child>servo1_pitch</child>
      <!-- <pose>0 0 0.1675 0 0 0</pose> -->
      <axis>
        <xyz>
        0 -1 0
        </xyz>
        <limit>
          <lower>-1</lower>
          <upper>1</upper>
          <!-- <effort>1.0</effort>
          <velocity>10.0</velocity> -->
        </limit>
        <!-- <dynamics>
          <damping>1.0</damping>  
          <friction>0.02</friction> 
        </dynamics> -->
      </axis>
    </joint>

    <joint name="pitch_to_motor" type="fixed">
      <parent>servo1_pitch</parent>
      <child>motor_housing</child>
    </joint>

    <joint name="motor1_joint" type="revolute">
      <parent>motor_housing</parent>
      <child>prop_upper</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <!-- <lower>-1e16</lower>
          <upper>1e16</upper> -->
          <!-- <effort>1.0</effort> -->
          <!-- <velocity>4000.0</velocity> -->
        </limit>
        <dynamics>
          <damping>0.001</damping>
          <friction>0.0001</friction>
        </dynamics>
      </axis>
    </joint>

    <joint name="motor2_joint" type="revolute">
      <parent>motor_housing</parent>
      <child>prop_lower</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <!-- <lower>-1e16</lower>
          <upper>1e16</upper> -->
          <!-- <effort>1.0</effort> -->
          <!-- <velocity>4000.0</velocity> -->
        </limit>
        <dynamics>
          <damping>0.001</damping>
          <friction>0.0001</friction>
        </dynamics>
      </axis>
    </joint>

    <plugin filename="gz-sim-multicopter-motor-model-system"
            name="gz::sim::systems::MulticopterMotorModel">
      <jointName>motor1_joint</jointName>
      <linkName>prop_upper</linkName>
      <turningDirection>ccw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>1400</maxRotVelocity>
      <motorConstant>0.0000048449</motorConstant>
      <momentConstant>0.1</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>0</motorNumber>
      <rotorDragCoefficient>0.0000000806428</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>20</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>

    <plugin filename="gz-sim-multicopter-motor-model-system"
            name="gz::sim::systems::MulticopterMotorModel">
      <jointName>motor2_joint</jointName>
      <linkName>prop_lower</linkName>
      <turningDirection>cw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>1400</maxRotVelocity>
      <motorConstant>0.0000048449</motorConstant>
      <momentConstant>0.1</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>1</motorNumber>
      <rotorDragCoefficient>0.0000000806428</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>20</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>

    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>servo1_pitch_joint</joint_name>
      <!-- <sub_topic>servo_1</sub_topic> -->
      <sub_topic>servo_pitch</sub_topic>
      <p_gain>1</p_gain>
    </plugin>

    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>servo0_roll_joint</joint_name>
      <!-- <sub_topic>servo_0</sub_topic> -->
      <sub_topic>servo_roll</sub_topic>
      <p_gain>1</p_gain>
    </plugin>

    <!-- <plugin filename="libTVCPlugin.so" name="TVCPlugin">
      <roll_joint>servo0_roll_joint</roll_joint>
      <pitch_joint>servo1_pitch_joint</pitch_joint>
      <engine_link>motor_housing</engine_link>
      <servo_max_speed>0.122</servo_max_speed>
      <servo_time_constant>0.10</servo_time_constant>
      <servo_min_len>0.085</servo_min_len>
      <servo_max_len>0.115</servo_max_len>
      <topic>/tvc_servo_command</topic>
    </plugin> -->

    <!-- Reference for custom TVC Servo Control Plugin with Real Gimbal Kinematics
    <plugin filename="libTVCPlugin.so" name="TVCPlugin">

      <dynamics_model>first_order</dynamics_model>        Dynamics Model Selection: "first_order" or "second_order" 
      
      Servo Physical Parameters
      <servo_max_speed>0.112</servo_max_speed>
      <servo_min_len>0.108</servo_min_len>  108 mm (corrected from 85mm) 
      <servo_max_len>0.135</servo_max_len>  135 mm (corrected from 115mm) 
      
      First-order Dynamics Parameters
      <servo_time_constant>0.2</servo_time_constant>  Increased from 0.1 to 0.2s for smoother response
      
      Second-order Dynamics Parameters
      <servo_natural_freq>5.0</servo_natural_freq> Natural frequency in rad/sec
      <servo_damping_ratio>0.7</servo_damping_ratio>
      
      Joint/Link References
      <roll_joint>servo0_roll_joint</roll_joint>
      <pitch_joint>servo1_pitch_joint</pitch_joint>
      <engine_link>motor_housing</engine_link>
      
      Input Configuration
      <input_mode>joint_position</input_mode>
      <input_format>normalized_minus1_1</input_format>
      
      PX4 SITL Servo Command Topics
      <servo_0_topic>/servo_0</servo_0_topic>
      <servo_1_topic>/servo_1</servo_1_topic>
      
      Legacy Transport Topic (backward compatibility)
      <transport_topic>/tvc_servo_command</transport_topic>
      
      REAL GIMBAL GEOMETRY PARAMETERS (in meters)
      These parameters define the gimbal mechanical structure
      Tail stroke clevis position (relative to gimbal center)
      <gimbal_xB>0.06741</gimbal_xB>     67.41 mm
      <gimbal_zB>0.0917</gimbal_zB>      91.7 mm
      Rod-end clevis position (relative to gimbal center)
      <gimbal_yE>0.06741</gimbal_yE>     67.41 mm
      <gimbal_zE>0.0917</gimbal_zE>      91.7 mm
      Gimbal arm parameters
      <gimbal_L4>0.0</gimbal_L4>      22.8 mm (origin to C along Z)
      <gimbal_L5>0.028</gimbal_L5>       28.0 mm (servo 1 arm length along X)
      <gimbal_L7>0.028</gimbal_L7>       28.0 mm (servo 2 arm length along Y)
      
       SERVO CALIBRATION PARAMETERS
      These parameters relate PWM/normalized input to servo stroke length
      Slope: change in length per unit PWM
      <servo_a3>0.0225</servo_a3>        22.5 mm per 1000 µs for servo 1
      <servo_a6>0.0225</servo_a6>        22.5 mm per 1000 µs for servo 2
      Neutral PWM values
      <servo_p01>1500.0</servo_p01>      1500 µs neutral for servo 1
      <servo_p02>1500.0</servo_p02>      1500 µs neutral for servo 2
      Servo length limits (from MightyZap 12LF-12PT-27: 27mm total stroke) 
      Neutral servo length is ~121 mm, so limits are neutral ± 13.5 mm
      <servo_L3_min>0.0861</servo_L3_min>  108 mm min for servo 1
      <servo_L3_max>0.1133</servo_L3_max>  135 mm max for servo 1 
      <servo_L6_min>0.0861</servo_L6_min>  108 mm min for servo 2 
      <servo_L6_max>0.1133</servo_L6_max>  135 mm max for servo 2 
    </plugin> -->

    <plugin filename="libTVCPlugin.so" name="TVCPlugin">

      <dynamics_model>second_order</dynamics_model>

      <servo_max_speed>0.112</servo_max_speed>
      <servo_min_len>0.108</servo_min_len>
      <servo_max_len>0.135</servo_max_len> 
    
      <servo_time_constant>0.2</servo_time_constant>
      
      <servo_natural_freq>37.07079327</servo_natural_freq>
      <servo_damping_ratio>0.95</servo_damping_ratio>
      
      <engine_link>motor_housing</engine_link>

      <input_mode>joint_position</input_mode>
      <input_format>normalized_minus1_1</input_format>

      <!-- Input Topics -->
      <servo_0_topic>/gazebo/servo_0</servo_0_topic>
      <servo_1_topic>/gazebo/servo_1</servo_1_topic>

      <transport_topic>/tvc_servo_command</transport_topic>
      
      <!-- Angle output topics for JointPositionController -->
      <roll_angle_topic>/model/viper/servo_roll</roll_angle_topic>
      <pitch_angle_topic>/model/viper/servo_pitch</pitch_angle_topic>
      
      <gimbal_xB>0.06741</gimbal_xB>
      <gimbal_zB>0.0917</gimbal_zB>
      <gimbal_yE>0.06741</gimbal_yE>
      <gimbal_zE>0.0917</gimbal_zE>
      <gimbal_L4>0.0228</gimbal_L4>
      <gimbal_L5>0.028</gimbal_L5>   
      <gimbal_L7>0.028</gimbal_L7>      
    
      <!-- Servo calibration parameters (matches tvc_model.py) -->
      <!-- a3, a6: servo stroke per unit normalized input (meters) -->
      <!-- 13.5mm stroke = 0.0135m for ±1.0 normalized input -->
      <!-- p01, p02: neutral reference (normalized inputs, set to 0) -->
      <servo_a3>0.0135</servo_a3>
      <servo_a6>0.0135</servo_a6>
      <servo_p01>0.0</servo_p01>
      <servo_p02>0.0</servo_p02>

      <servo_L3_min>0.108</servo_L3_min>
      <servo_L3_max>0.135</servo_L3_max>
      <servo_L6_min>0.108</servo_L6_min>
      <servo_L6_max>0.135</servo_L6_max>
    </plugin>

    <plugin filename="libgz-sim-pose-publisher-system.so"
            name="gz::sim::systems::PosePublisher">
      <publish_world_pose>true</publish_world_pose>
      <publish_link_pose>true</publish_link_pose>
      <publish_collision_pose>false</publish_collision_pose>
      <publish_visual_pose>false</publish_visual_pose>
      <!-- <use_pose_vector_msg>true</use_pose_vector_msg>
      <static_publisher>true</static_publisher>
      <static_update_frequency>10</static_update_frequency> -->
    </plugin>

    <plugin filename="gz-sim-odometry-publisher-system"
    name="gz::sim::systems::OdometryPublisher">
      <dimensions>3</dimensions>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system" 
    name="gz::sim::systems::JointStatePublisher">
      <topic>gimbal_roll</topic>
      <joint_name>servo0_roll_joint</joint_name>
    </plugin>
  
    <plugin filename="gz-sim-joint-state-publisher-system" 
    name="gz::sim::systems::JointStatePublisher">
      <topic>gimbal_pitch</topic>
      <joint_name>servo1_pitch_joint</joint_name>
    </plugin>

